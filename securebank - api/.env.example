# ─── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://securebank:securebank_pass@localhost:5432/securebank_db

# ─── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=myV3ryL0ngRand0mStr1ngThatIsAtLeast64CharsLongForSecurity!!
JWT_REFRESH_SECRET=an0th3rDiff3rentV3ryL0ngRand0mStr1ngForRefreshT0kens!!123
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Bcrypt ──────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ─── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── Account Lock ────────────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_DURATION_MINUTES=30
